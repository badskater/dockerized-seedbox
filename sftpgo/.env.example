# ---- Traefik integration ----
# External Docker network shared with Traefik (create once: docker network create proxy)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt

# Hostname for the SFTPGo Web Admin/Client UI + REST API (https://<host>/web/admin)
# REQUIRED — compose fails fast if unset.
SFTPGO_HOST=sftp.example.com
# Hostname for WebDAV access
# REQUIRED — compose fails fast if unset.
SFTPGO_WEBDAV_HOST=dav.example.com

ROUTER_NAME=sftpgo
WEBDAV_ROUTER_NAME=sftpgo-webdav

# ---- Image / runtime ----
SFTPGO_IMAGE_TAG=v2.7.6
# The official drakkan/sftpgo image runs as uid/gid 1000 (NOT 1100).
# The host dirs below must be writable by uid 1000:
#   sudo chown -R 1000:1000 $SFTPGO_HOST_CONFIG_DIR $SFTPGO_HOST_DATA_DIR
# Otherwise sqlite can't create its DB → "unable to open database file" loop.
# Graceful shutdown window in seconds for active SFTP/FTP/WebDAV connections
SFTPGO_GRACE_TIME=30

# ---- Host directories ----
# IMPORTANT: keep the SFTPGO_HOST_ prefix on these. A bare SFTPGO_CONFIG_DIR
# in .env would be passed into the container by env_file and override SFTPGo's
# config dir (crash loop: "unable to open database file").
# Config: sftpgo.json, database (sqlite by default), certs, backups
SFTPGO_HOST_CONFIG_DIR=./data/config
# Served files / per-user home directories
SFTPGO_HOST_DATA_DIR=./data/srv

# ---- Internal ports (must match compose.yaml; defaults shown) ----
SFTPGO_HTTP_PORT=8080
SFTPGO_SFTP_PORT=2022
SFTPGO_WEBDAV_PORT=8081
SFTPGO_FTP_PORT=2021

# ---- SFTPGo application config (SFTPGO_* env vars, see
#      https://docs.sftpgo.com/latest/env-vars/ — "__" traverses structs) ----
# Data provider: sqlite (default, file inside /var/lib/sftpgo), or
# mysql/postgresql/boltdb/memory. For SQL backends also set NAME/HOST/PORT/USERNAME/PASSWORD.
SFTPGO_DATA_PROVIDER__DRIVER=sqlite
# Create the initial admin account on first start (only applied once, on an
# empty database). REQUIRES both credential vars below or startup fails with
# "to create the default admin you need to set the env vars ...".
SFTPGO_DATA_PROVIDER__CREATE_DEFAULT_ADMIN=true
SFTPGO_DEFAULT_ADMIN_USERNAME=admin
SFTPGO_DEFAULT_ADMIN_PASSWORD=change…rase

# Any other sftpgo.json setting can be added here, e.g.:
# SFTPGO_SFTPD__BINDINGS__0__HOST_KEY_PATH=/var/lib/sftpgo/ssh_host_key
# SFTPGO_COMMON__DEFENDER__ENABLED=true
# SFTPGO_HTTPD__BINDINGS__0__ENABLE_REST_API=false
#
# FTP (disabled by default). To enable, uncomment below AND the FTP ports
# in compose.yaml, and forward the passive range on your router/firewall:
# SFTPGO_FTPD__BINDINGS__0__PASSIVE_PORT_RANGE__START=50000
# SFTPGO_FTPD__BINDINGS__0__PASSIVE_PORT_RANGE__END=50010
# Public IP advertised in FTP passive mode responses:
# SFTPGO_FTPD__BINDINGS__0__FORCE_PASSIVE_IP=<your-public-ip>