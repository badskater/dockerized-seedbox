##############################################################################
## iroffer-dinoex docker environment
##
## EVERY iroffer config directive is supported as an environment variable:
##   IROFFER_<DIRECTIVE_UPPERCASE>=value
## e.g. slotsmax -> IROFFER_SLOTSMAX, adminpass -> IROFFER_ADMINPASS
##
## Rules:
##   * Unset/empty variable = the value in iroffer.config is kept.
##   * Values are applied on EVERY container start into a managed
##     "# BEGIN IROFFER ENV OVERRIDES" region at the top of iroffer.config
##     (env always wins over the file for that directive).
##   * Multi-value directives ([multi] below) accept ";;"-separated values,
##     one config line per value (e.g. IROFFER_FILEDIR="/data;;/data2").
##   * Bool directives ([yes|no]) only accept "yes" or "no".
##   * Network-scoped directives ([also per-network]) can additionally be set
##     per network via IROFFER_NETWORK_<n>_<DIRECTIVE> (see below).
##############################################################################

# ---- Traefik integration ----
# External Docker network shared with Traefik (create once: docker network create proxy)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt

# Hostname for the iroffer webserver (public XDCC pack list, no auth).
# REQUIRED — compose fails fast if unset. Must be a real DNS-managed domain
# (Let's Encrypt DNS-01 cannot issue certs for .lan/internal names).
XDCC_HOST=xdcc.example.com

# Internal router/service name — must be unique across your whole stack
ROUTER_NAME=iroffer

# ---------------- Deployment ----------------
# Image tag (CI-built image from ghcr.io/badskater/iroffer-dinoex).
# To build locally instead:  docker compose up -d --build
IMAGE_TAG=latest

# Build arguments (mapped to Dockerfile ARG values)
IROFFER_USER_ID=1000
IROFFER_GROUP_ID=1000

# Host directories (mounted into the container)
CONFIG_DIR=./config
DATA_DIR=./files

# ---------------- Runtime (legacy aliases) ----------------
# Bot nick; applied as user_nick unless IROFFER_USER_NICK is set.
IROFFER_BOT_NAME=iroffer

# DCC passive port range; published by docker and applied as
# tcprangestart/tcprangelimit unless IROFFER_TCPRANGESTART/LIMIT are set.
PORT_RANGE=30000-31000

# Built-in webserver port — Traefik proxies to it (expose-only, never
# published on the host). Applied as http_port unless IROFFER_HTTP_PORT is
# set. MUST be set for the Traefik router/healthcheck to work.
HTTP_PORT=8080

##############################################################################
## Network blocks (optional; generated on startup)
## When IROFFER_NETWORK_COUNT is set, the entrypoint rewrites the
## "network { ... }" blocks of iroffer.config on every start. Existing blocks
## are commented out as "#removed-by-env:" (recoverable by hand).
## Any network-scoped directive works as IROFFER_NETWORK_<n>_<DIRECTIVE>;
## server/channel accept ";;"-separated multiples.
##############################################################################
#IROFFER_NETWORK_COUNT=1
#IROFFER_NETWORK_1_NAME=rizon
#IROFFER_NETWORK_1_SERVER=irc.rizon.net 6667
#IROFFER_NETWORK_1_CHANNEL=#mychannel -noannounce
#IROFFER_NETWORK_1_CONNECTIONMETHOD=ssl
#IROFFER_NETWORK_1_USER_NICK=MyBot
#IROFFER_NETWORK_1_NICKSERV_PASS=secret
#IROFFER_NETWORK_1_SERVER=irc.rizon.net 6667;;irc2.rizon.net 6669
#IROFFER_NETWORK_1_CHANNEL=#chan1;;#chan2 -noannounce

##############################################################################
## All config directives (grouped as in upstream sample.config)
##############################################################################


# ---- IRC / adddir exclude pattern ----
# (list [multi: ';;'-separated]) When configured, addir, adnew and autoadd will skip all files or dirs that match this patterns.
#IROFFER_ADDDIR_EXCLUDE=*.txt

# ---- IRC / adddir match pattern ----
# (list [multi: ';;'-separated]) When configured, addir, adnew and autoadd will skip all files that do not match this patterns.
#IROFFER_ADDDIR_MATCH=*.avi

# ---- IRC / adddir min size ----
# (int) When configured, addir, adnew and autoadd will skip all files that are smaller then the gives size in kB. Default: no check
#IROFFER_ADDDIR_MIN_SIZE=10

# ---- FILES / admin job done file ----
# (string) Write the output from the commands in "admin_job_file" into this file. Default: <admin_job_file>.done
#IROFFER_ADMIN_JOB_DONE_FILE=mybot.done

# ---- FILES / admin job file ----
# (string) when defined, read this file for commands and execute them.
#IROFFER_ADMIN_JOB_FILE=mybot.job

# ---- Other / remote admin info ----
# (list [multi: ';;'-separated])
#IROFFER_ADMINHOST=*!~me@*.domain.com
# (string) Remote commands can only be issued by a nick with a matching hostmask and knows the adminpass. Remote commands are issued by dcc chat or by /msg ni...
# The config requires an ENCRYPTED password. Generate the hash with:
#   docker run -it --rm ghcr.io/badskater/iroffer-dinoex -c /tmp/config
# (prompts twice, prints "adminpass $1$..", and appends the line to the file
# given after -c). Put the hash here or in iroffer.config.
# IMPORTANT: crypt hashes contain $ — compose interpolates $ sequences in
# .env values, so ALWAYS single-quote the hash or you'll get bogus
# 'The "…" variable is not set' warnings and a truncated password:
#   IROFFER_ADMINPASS='$1$xy$....'
#IROFFER_ADMINPASS=add_your_encrypted_password_here

# ---- Other / remote admin level ----
# (int) Limit remote admin commands to level. 1 = info and stats only 2 = lock and unlock 3 = add and change 4 = remove packs 5 = full, may rename or remov...
#IROFFER_ADMINLEVEL=4

# ---- IRC / announce seperator ----
# (string) printed between pack number and name on announce. Default: space
#IROFFER_ANNOUNCE_SEPERATOR=" "

# ---- IRC / announce size ----
# (bool [yes|no]) Print size of pack on announce. Default: no
#IROFFER_ANNOUNCE_SIZE=yes

# ---- IRC / announce suffix color ----
# (string) Set color for the instructions suffix in the announce message. This will print the text "/MSG <botname> XDCC GET <nr>" in color. Default no color.
#IROFFER_ANNOUNCE_SUFFIX_COLOR=0,0,1

# ---- IRC / channel @find command ----
# (int) iroffer will respond to "@find pattern" requests sent to a channel with a pattern that contains at least <n> non wild cards chars wild cards are: *...
#IROFFER_ATFIND=3

# ---- IRC / auth name ----
# (func [also per-network]) If you would like to register with the AUTH command you need to define the name if the service you have to use here. You can append a username to u...
#IROFFER_AUTH_NAME=Q@CServe.quakenet.org

# ---- IRC / auto crc check ----
# (bool [yes|no]) When adding a new file, verify the crc32 in the given filename.
#IROFFER_AUTO_CRC_CHECK=yes

# ---- IRC / auto default group ----
# (bool [yes|no]) When adding a new file, search for matching filenames and add the new file to the same group.
#IROFFER_AUTO_DEFAULT_GROUP=yes

# ---- IRC / auto path group ----
# (bool [yes|no]) When adding a new file, search for matching directories and add the new file to the same group.
#IROFFER_AUTO_PATH_GROUP=yes

# ---- IRC / auto add color ----
# (string) Set color for files to be added in autoadd_dir. Default no color. Format: <color>,<background>,<style> values for color, background: 0 no color 1 b...
#IROFFER_AUTOADD_COLOR=0,0,1

# ---- IRC / auto add delay ----
# (int) Time in seconds that files must been unchanged to be added. Default: 0 = disabled.
#IROFFER_AUTOADD_DELAY=300

# ---- IRC / auto add dir ----
# (list [multi: ';;'-separated]) Directory for files that will be added without further interaction either by "autoadd_time" or by the "AUTOADD" command. You can list multiple dire...
#IROFFER_AUTOADD_DIR=/home/me/new

# ---- IRC / auto add group ----
# (string) Set group for files to be added in autoadd_dir. Default "MAIN"
#IROFFER_AUTOADD_GROUP=NEWSTUFF

# ---- IRC / autoadd_group match ----
# (func [multi: ';;'-separated]) Define groups for files to be added in autoadd_dir based on matching the given pattern with the full path of the file.
#IROFFER_AUTOADD_GROUP_MATCH=NEWVIDEO *.avi

# ---- IRC / auto add sort ----
# (string) If defined, all added packs will be inserted in the giving order. The existing packs must already be sorted in the same way. You can define multipl...
#IROFFER_AUTOADD_SORT=GROUP NAME

# ---- IRC / auto add time ----
# (int) Time in seconds when the bot checks for new files in autoadd_dir. Default: 0 = disabled.
#IROFFER_AUTOADD_TIME=300

# ---- IRC / auto add announce ----
# (string) When configured, each add will be announced on all channels with <msg> patterns.
#IROFFER_AUTOADDANN=added

# ---- IRC / auto add announce match ----
# (list [multi: ';;'-separated]) When configured, addir, adnew and autoadd will only announce files that do match this patterns.
#IROFFER_AUTOADDANN_MASK=*.avi

# ---- IRC / auto add announce short ----
# (bool [yes|no]) When configured, each add will be announced on all channels with pack Number and Filename.
#IROFFER_AUTOADDANN_SHORT=yes

# ---- IRC / crc exclude pattern ----
# (list [multi: ';;'-separated]) When configured, auto crc check will ignore files matching this patterns.
#IROFFER_AUTOCRC_EXCLUDE=*.torrent

# ---- IRC / excluded from auto-ignore ----
# (list [multi: ';;'-separated]) These hostmasks (one per line) will never be ignored.
#IROFFER_AUTOIGNORE_EXCLUDE=nickserv!nickserv@services.domain.com

# ---- IRC / auto-ignore rate ----
# (int) How strict should the auto-ignore be? autoignore_rate is the maximum number of requests per second from a user. auto-ignore. The default is 8 request.
#IROFFER_AUTOIGNORE_RATE=8

# ---- IRC / auto-ignore threshold ----
# (int) How long should the auto-ignore last? autoignore_threshold is the average number of seconds between requests that will re-trigger the auto-ignore. ...
#IROFFER_AUTOIGNORE_THRESHOLD=10

# ---- Other / autosend feature ----
# (func) Set if you want iroffer to automatically send a pack when someone says a certain word publicly in a channel. Only the first matching trigger will s...
#IROFFER_AUTOSENDPACK=1 !rules Sending you the rules.

# ---- IRC / balanced_queue ----
# (bool [yes|no]) When a user is done using a slot, the next file retrieved from the queue would NOT be a file queued by the same user. This helps to distribute the ...
#IROFFER_BALANCED_QUEUE=yes

# ---- IRC / channels (up to 50) ----
# (func [multi: ';;'-separated] [also per-network]) channel format: "channel <channel> [-plist <time>] [-plistoffset <time>] [-pformat <full|minimal|summary>] [-pgroup <group>] [-key <key>] [-delay <...
#IROFFER_CHANNEL=#chan01
# (string [also per-network])
#IROFFER_USER_NICK=XDCC|MyBot|IPv6

# ---- IRC / onjoin information ----
# (func [multi: ';;'-separated] [also per-network])
#IROFFER_CHANNEL_JOIN_RAW=
# (func [multi: ';;'-separated] [also per-network])
#IROFFER_SERVER_CONNECTED_RAW=
# (func [multi: ';;'-separated] [also per-network]) you can use server_join_raw to send raw IRC commands to the server when connected (sent after NICK, USER, before MODE ) you can use server_connecte...
#IROFFER_SERVER_JOIN_RAW=

# ---- FILES / charset ----
# (string) This must be set to the encoding of your filenames. The charset in header.html must match to this. Default: UTF-8
#IROFFER_CHARSET=UTF-8

# ---- IRC / connection method ----
# (func [multi: ';;'-separated] [also per-network]) How should iroffer connect to the irc server. Choices are: direct - connect directly to the irc server ssl - connect to the irc server via SSL. Mak...
#IROFFER_CONNECTIONMETHOD=direct

# ---- Other / credit line ----
# (string) Put a credit at the end of your xdcc list
#IROFFER_CREDITLINE=Brought to you by me

# ---- Other / debug ----
# (int) Show more information on the Console. Default: 0 == none 1 = general debug messages 11 = channel members 12 = dcc chat 13 = queued irc 14 = crypted...
#IROFFER_DEBUG=1

# ---- Other / direct config access ----
# (bool [yes|no]) Enable admin commands to manipulate configuration.
#IROFFER_DIRECT_CONFIG_ACCESS=yes

# ---- Other / direct file access ----
# (bool [yes|no]) Enable admin commands to manipulate files on disk. This is required if you want to download files with FETCH.
#IROFFER_DIRECT_FILE_ACCESS=yes

# ---- Other / disablexdccinfo ----
# (bool [yes|no]) disable all XDCC INFO requests
#IROFFER_DISABLEXDCCINFO=yes

# ---- Other / disk quota ----
# (func) Check used space on disk for files and do not add more packs. Specifies the maximum size in MB used in all packs.
#IROFFER_DISK_QUOTA=1000

# ---- FILES / dos text files ----
# (bool [yes|no]) Write xdcclistfile as DOS text format, with CRLF als line break. Default: no, on CYGWIN Default: yes
#IROFFER_DOS_TEXT_FILES=yes

# ---- Other / download completed msg ----
# (string) Put a credit at the end of each transfer.
#IROFFER_DOWNLOAD_COMPLETED_MSG=Please visit http://www.example.com/

# ---- IRC / authorized download hosts ----
# (list [multi: ';;'-separated]) Specify who can download from this bot. Use *!*@* to allow anyone. Multiple hostmasks can be specified wild cards are: * = 0 or more characters, ? ...
#IROFFER_DOWNLOADHOST=*!*@*

# ---- Other / dump all ----
# (bool [yes|no]) If set shows all config vars on DUMP. Default is to show only non default entries.
#IROFFER_DUMP_ALL=yes

# ---- IRC / watch this user ----
# (string) No new "xdcc send" are accepted, when this user is not online. Old queue entries are still send.
#IROFFER_ENABLE_NICK=ownernick

# ---- FILES / expire logfiles ----
# (int) After the given number of days the old logfiles are deleted. This will only be checked after logrotate. Default: logfiles are not deleted.
#IROFFER_EXPIRE_LOGFILES=31

# ---- Network Usage / extend status line ----
# (bool [yes|no]) print out upload and download bandwidth in status line.
#IROFFER_EXTEND_STATUS_LINE=yes

# ---- IRC / add/chfile command helper directory ----
# (list [multi: ';;'-separated]) optional directory where iroffer will look after trying normal relative/absolute paths when using the add or chfile admin command. Add/chfile will ...
#IROFFER_FILEDIR=/home/me/files

# ---- Other / fileremove max packs ----
# (int) Max number of packs on this bot, if more are added, the oldest ones are removed from disk. Default: 0 = disabled.
#IROFFER_FILEREMOVE_MAX_PACKS=10

# ---- IRC / fish exclude nick ----
# (list [multi: ';;'-separated]) Messages to this nicks won't be encryted.
#IROFFER_FISH_EXCLUDE_NICK=nickserv

# ---- IRC / fish only ----
# (bool [yes|no]) If set, ignores not encrypted triggers in channels with a fish key.
#IROFFER_FISH_ONLY=yes

# ---- IRC / flood protection rate ----
# (int) How strict should the bot activate its global flooding protection. Value is the maximum number successful executed commands in the last 10 seconds....
#IROFFER_FLOOD_PROTECTION_RATE=6

# ---- IRC / get ip from network ----
# (func [also per-network]) Get my own IP for the current Network from a different network. You need this when the given network does not return your IP.
#IROFFER_GETIP_NETWORK=1

# ---- IRC / automatic dcc ip translation ----
# (bool [yes|no]) Get my own IP from the irc server and use this as value for usenatip. Set usenatip to a default value (0.0.0.0) when using this option. Not all irc...
#IROFFER_GETIPFROMSERVER=yes
# (bool [yes|no]) Get my own IP from the upnp router and use this as value for usenatip. Set usenatip to a default value (0.0.0.0) when using this option. Requires i...
#IROFFER_GETIPFROMUPNP=yes

# ---- Other / remote group admin ----
# (func [multi: ';;'-separated]) Remote commands can only be issued by a nick with a matching hostmask and knows the coresponding password. Access is limit to the groups listed in ...
#IROFFER_GROUP_ADMIN=3 *!~me@*.domain.com encrypted_password GROUP1,GROUP2

# ---- FILES / group seperator ----
# (string) printed between group name and group description. Default: space
#IROFFER_GROUP_SEPERATOR=" "

# ---- IRC / groups in caps ----
# (bool [yes|no]) if set, all groups names changed will be folded to uppercase.
#IROFFER_GROUPSINCAPS=yes

# ---- Other / remote half admin info ----
# (list [multi: ';;'-separated])
#IROFFER_HADMINHOST=*!~me@*.domain.com
# (string) Remote commands can only be issued by a nick with a matching hostmask and knows the hadminpass. Remote commands are issued by dcc chat or by /msg n...
# Single-quote the crypt hash here too (see IROFFER_ADMINPASS note above).
#IROFFER_HADMINPASS=add_your_encrypted_password_here

# ---- Other / remote half admin level ----
# (int) Limit remote half admin commands to level. Values see adminlevel Default: 2
#IROFFER_HADMINLEVEL=3

# ---- Other / headline ----
# (list [multi: ';;'-separated]) Put a headline at the top of all xdcc lists
#IROFFER_HEADLINE=New Stuff Just Added!!

# ---- Other / hide_list_info ----
# (bool [yes|no]) Don't print line with "/msg nick xdcc info #x"
#IROFFER_HIDE_LIST_INFO=yes

# ---- Other / hide_list_stop ----
# (bool [yes|no]) Don't print line with "/msg nick xdcc stop"
#IROFFER_HIDE_LIST_STOP=yes

# ---- Other / hidelockedpacks ----
# (bool [yes|no]) Don't show locked packs to users with XDCC INFO and XDCC SEND
#IROFFER_HIDELOCKEDPACKS=yes

# ---- Other / hide OS information ----
# (bool [yes|no]) If you do not want iroffer to show OS information in version and quit messages enable this option
#IROFFER_HIDEOS=yes

# ---- IRC / holdqueue ----
# (bool [yes|no]) don't send from queue, let current transfers run out, so the bot can shutdown cleanly without stopping transfers
#IROFFER_HOLDQUEUE=yes

# ---- FILES / http access log ----
# (string) If defined, iroffer will log http request in CLF compatible format. Default: disabled.
#IROFFER_HTTP_ACCESS_LOG=httpd_access.log

# ---- FILES / http admin ----
# (string) Defines admin login for the build-in webserver. Default: disabled.
#IROFFER_HTTP_ADMIN=superuser

# ---- FILES / http admin dir ----
# (string) Defines directory for protected files handled out by the webserver for the admin user. Default: disabled.
#IROFFER_HTTP_ADMIN_DIR=htadmin

# ---- FILES / http allow ----
# (list [multi: ';;'-separated]) Defines ip networks, which are allowed to access the server. Multiple ip networks can be specified Default: all.
#IROFFER_HTTP_ALLOW=127.0.0.1

# ---- FILES / http date ----
# (string) Define output from of dates on the webpage. Default: %Y-%m-%d %H:%M
#IROFFER_HTTP_DATE=%Y-%m-%d %H:%M

# ---- FILES / http deny ----
# (list [multi: ';;'-separated]) Defines ip networks, that should not access the server. Multiple ip networks can be specified Default: none.
#IROFFER_HTTP_DENY=172.16.0.0/16

# ---- FILES / http dir ----
# (string) Defines directory for extra files handled out by the webserver. For example: robots.txt favicon.ico Default: disabled.
#IROFFER_HTTP_DIR=htdocs

# ---- FILES / http forbidden ----
# (string) Defines the URL page to show when access is forbidden. The given URL must resolve in a file in http_dir. Default: Send only the HTTP error.
#IROFFER_HTTP_FORBIDDEN=/forbidden.html

# ---- FILES / http geoip ----
# (bool [yes|no]) Enables geoip country check for HTTP requests. Default: disabled.
#IROFFER_HTTP_GEOIP=yes

# ---- FILES / http index ----
# (string) Defines the page to show when no filename is given in the URL. Default: xdcclistfile For Weblist set: http_index /? For your own static page in htd...
#IROFFER_HTTP_INDEX=/?

# ---- FILES / http port ----
# (int) Port for the build-in webserver. Default: 0 = disabled.
#IROFFER_HTTP_PORT=8000

# ---- FILES / http search ----
# (bool [yes|no]) Enables search form in HTML page. Default: disabled.
#IROFFER_HTTP_SEARCH=yes

# ---- FILES / http vhost ----
# (list [multi: ';;'-separated]) List of up to 2 local IP addresses for the Webserver to run on. Use "::" or "0.0.0.0" to allow any IP address. Use "::1" or "127.0.0.1" to limit ac...
#IROFFER_HTTP_VHOST=::

# ---- IRC / idle queue size ----
# (int) Idle queue size, set to 0 for no queue This queue is required to support XDCC BACTH.
#IROFFER_IDLEQUEUESIZE=100

# ---- IRC / ignore duplicate ip ----
# (int) Detect faked hostmasks and abort multiple transfers to the same host and ignore the user for the give time in hours. Default: 0 == no check.
#IROFFER_IGNORE_DUPLICATE_IP=24

# ---- IRC / misc ----
# (func [yes|no]) Alias of ignore_duplicate_ip.
#IROFFER_IGNOREDUPLICATEIP=yes

# ---- Network Usage / ignore upload bandwidth ----
# (bool [yes|no]) don't count uploads traffic into transferlimits. Fast uploads will stop any downloads without this option.
#IROFFER_IGNOREUPLOADBANDWIDTH=yes

# ---- IRC / include subdirs ----
# (bool [yes|no]) When configured, addir, addnew and removedir will scan into sub- directories and process the files found.
#IROFFER_INCLUDE_SUBDIRS=yes

# ---- IRC / virtual hosts ----
# (string [also per-network]) If the computer you want to run iroffer on has multiple local IP addresses, you can run iroffer on any of those IP addresses. To automatically choo...
#IROFFER_LOCAL_VHOST=123.456.789.123

# ---- Other / log exclude host ----
# (list [multi: ';;'-separated]) Exclude given list of hostmasks from filling up your logfiles or polluting your saved messages.
#IROFFER_LOG_EXCLUDE_HOST=SpamScanner!scanner@euirc.net

# ---- Other / log exclude text ----
# (list [multi: ';;'-separated]) Exclude given list of patterns from filling up your logfiles or polluting your saved messages. Wild cards are: * = 0 or more characters, ? = 1 char...
#IROFFER_LOG_EXCLUDE_TEXT=LAG

# ---- FILES / log file ----
# (string) Writes logging information to this file.
#IROFFER_LOGFILE=mybot.log

# ---- Other / logfile httpd ----
# (string) If defined, iroffer will log http request and errors in this logfile.
#IROFFER_LOGFILE_HTTPD=httpd_error.log

# ---- Other / logfile notices/messages ----
# (string)
#IROFFER_LOGFILE_MESSAGES=message.log
# (string) If defined, iroffer will log notices and/or messages to the given logfile.
#IROFFER_LOGFILE_NOTICES=notice.log

# ---- IRC / login name ----
# (func [also per-network]) If you would like to register with the LOGIN command you need to define the name if the service you have to use here. This setting can only be set ...
#IROFFER_LOGIN_NAME=X@channels.undernet.org

# ---- IRC / override unix loginname ----
# (string) Override your unix loginname. Will only work if identd isn't running.
#IROFFER_LOGINNAME=fakelogin

# ---- Other / log notices/messages ----
# (bool [yes|no])
#IROFFER_LOGMESSAGES=yes
# (bool [yes|no]) If defined, iroffer will log notices and/or messages to the msglog
#IROFFER_LOGNOTICES=yes

# ---- FILES / log rotate ----
# (func) After the time given here a logfile will be rotated. logrotate can be set to none, 1 - 24 hours, daily, weekly or monthly
#IROFFER_LOGROTATE=weekly

# ---- FILES / log stats ----
# (bool [yes|no]) Setting logstats will log statistical information and this will also send this stats to a dcc chat if one is active.
#IROFFER_LOGSTATS=yes

# ---- Network Usage / Allow with low bandwidth ----
# (int) If packs are queued, and the bandwidth usage is below this amount, a queued person will be sent their pack. (K/sec) WARNING! do not set this amount...
#IROFFER_LOWBDWTH=15

# ---- IRC / max find ----
# (int) Limit matches to @find and XDCC SEARCH commands. Default: 0 = no limit.
#IROFFER_MAX_FIND=100

# ---- Other / max uploads ----
# (int) Do not allow more than given number of concurrent uploads. Default: not limited.
#IROFFER_MAX_UPLOADS=3

# ---- Other / max upspeed ----
# (int) You can set a maximum KB/sec that will be uploaded over the network. Default: no limit.
#IROFFER_MAX_UPSPEED=1000

# ---- IRC / max idle queued items per person ----
# (int) maximum number of times a user can be in the idle queue simultaneously
#IROFFER_MAXIDLEQUEUEDPERPERSON=20

# ---- IRC / max queued items per person ----
# (int) maximum number of times a user can be in a queue simultaneously
#IROFFER_MAXQUEUEDITEMSPERPERSON=1

# ---- IRC / max transfers per person ----
# (int) maximum transfers per person at a time
#IROFFER_MAXTRANSFERSPERPERSON=1

# ---- Other / md5sum exclude pattern ----
# (list [multi: ';;'-separated]) When configured, MD5 and CRC32 will be not computed for files matching this patterns.
#IROFFER_MD5SUM_EXCLUDE=*.txt

# ---- FILES / mime type ----
# (func [multi: ';;'-separated]) Define additional mime types for the HTML pages.
#IROFFER_MIME_TYPE=torrent application/x-bittorrent

# ---- IRC / mirc dcc64 ----
# (bool [yes|no]) All transfers greater 4GB will use mIRC style 64bit DCC. NOTE: This works only with mIRC version 6.33 and upper. NOTE: XChat, Irssi will work only ...
#IROFFER_MIRC_DCC64=yes

# ---- IRC / monitor files ----
# (int) Check only given number of files per second for removal or update. Default: 20
#IROFFER_MONITOR_FILES=20

# ---- IRC / need level ----
# (int [also per-network]) Restrict list/send to only voiced/opped users. restrictlist and restrictsend must be set yes. This setting can be global or per network. 0 = all us...
#IROFFER_NEED_LEVEL=1

# ---- IRC / need voice ----
# (bool [yes|no]) Restrict list/send to only voiced/opped users. restrictlist and restrictsend must be set yes. This setting can be global or per network.
#IROFFER_NEED_VOICE=yes

# ---- IRC / network name ----
# 'network' blocks are managed via IROFFER_NETWORK_COUNT + IROFFER_NETWORK_<n>_* (see above).

# ---- IRC / new trigger ----
# (int) iroffer will respond to "!new" requests sent to a channel. It will respond with latest <n> packs added. Default: 0 = no response at all
#IROFFER_NEW_TRIGGER=3

# ---- IRC / nickserv ----
# (string [also per-network]) If you would like to register with nickserv add settings here. This setting can be global or per network.
#IROFFER_NICKSERV_PASS=mypass

# ---- Network Usage / no auto rehsh ----
# (bool [yes|no]) If defined, iroffer will not automaticlly REHASH when a configfile was was changed. Default: Do a REHASH.
#IROFFER_NO_AUTO_REHASH=yes

# ---- IRC / no duplicate filenames ----
# (bool [yes|no]) When configured, add, adddir and addnew refuses to add a files with a name that already have been added.
#IROFFER_NO_DUPLICATE_FILENAMES=yes

# ---- IRC / no find trigger ----
# (bool [yes|no]) Iroffer will respond to "!find" too if atfind is defined. This flag will make the bot ignore "!find". Default: response to "!find"
#IROFFER_NO_FIND_TRIGGER=yes

# ---- Other / no minspeed on free ----
# (bool [yes|no]) Don't enforce minspeed when bot still has free slots.
#IROFFER_NO_MINSPEED_ON_FREE=yes

# ---- IRC / no natural sort ----
# (bool [yes|no]) If configurend, all text is sorted by plain ASCII. Default: use natural sort order.
#IROFFER_NO_NATURAL_SORT=yes

# ---- Network Usage / no status chat ----
# (bool [yes|no]) If defined, iroffer will suppress status line in chat.
#IROFFER_NO_STATUS_CHAT=yes

# ---- Network Usage / no status log ----
# (bool [yes|no]) If defined, iroffer will suppress status line in logfile.
#IROFFER_NO_STATUS_LOG=yes

# ---- IRC / noannounce ----
# (func [yes|no] [also per-network]) Disable all announces for the current network.
#IROFFER_NOANNOUNCE=

# ---- IRC / no auto rejoin ----
# (bool [yes|no]) Do not rejoin channel when bots is kicked.
#IROFFER_NOAUTOREJOIN=yes

# ---- Other / disable crc32 of files ----
# (bool [yes|no]) By default, iroffer will calculate crc32 checksums for all offered files. If you want to disable this feature define 'nocrc32' below.
#IROFFER_NOCRC32=yes

# ---- IRC / blocklist download hosts ----
# (list [multi: ';;'-separated]) Specify who can not download from this bot. Multiple hostmasks can be specified wild cards are: * = 0 or more characters, ? = 1 character, # = any ...
#IROFFER_NODOWNLOADHOST=*!~me@*.domain.com

# ---- IRC / no duplicate files ----
# (bool [yes|no]) When configured, add, adddir and addnew refuses to add a files that already have been added.
#IROFFER_NODUPLICATEFILES=yes

# ---- Other / disable md5sum of files ----
# (bool [yes|no]) By default, iroffer will calculate md5sums all offered files. If you want to disable this feature define 'nomd5sum' below. nomd5sum implies nocrc32...
#IROFFER_NOMD5SUM=yes

# ---- Other / periodic notify time ----
# (int) How often should iroffer notify users of queue/bandwidth status (in minutes). If not defined default is 5 minutes. Setting to 0 disables notificati...
#IROFFER_NOTIFYTIME=5

# ---- IRC / offline ----
# (func [yes|no] [also per-network]) Disable connecting to this network.
#IROFFER_OFFLINE=

# ---- FILES / old state file ----
# (bool [yes|no]) Writes smaller iroffer statefile by default. Set this option to write a statefile that is compatible with old versions. WARNING!! You need this opt...
#IROFFER_OLD_STATEFILE=yes

# ---- Network Usage / bandwidth limiting ----
# (int) Is your sysadmin complaining about you using up too much bandwidth? You can set a maximum KB/sec that will be sent to the network. Please set the m...
#IROFFER_OVERALLMAXSPEED=300
# (func)
#IROFFER_OVERALLMAXSPEEDDAYDAYS=MTWRF
# (int)
#IROFFER_OVERALLMAXSPEEDDAYSPEED=100
# (func)
#IROFFER_OVERALLMAXSPEEDDAYTIME=9 17

# ---- IRC / owner nick ----
# (string) Nick to notify if bot has trouble. Answer to XDCC OWNER command.
#IROFFER_OWNER_NICK=OwnerNick mailto:user@example.com

# ---- IRC / passive dcc ----
# (bool [yes|no]) Force all downloads over passive dcc. NOTE: all users must have working NAT on their end with this option. Default: normal dcc
#IROFFER_PASSIVE_DCC=yes

# ---- Other / passive dcc xchat ----
# (bool [yes|no]) Allow all admins to use passive DCC chat on the bot. Default: off. Admins must use "/MSG bot ADMIN password CHATME" instead.
#IROFFER_PASSIVE_DCC_CHAT=yes

# ---- Other / index bot notify ----
# (func [multi: ';;'-separated]) if you want iroffer to periodically msg some nick for indexing or some other purpose use periodicmsg in the form: "periodicmsg <nick> <num minutes>...
#IROFFER_PERIODICMSG=nick 10 index me

# ---- FILES / pid file ----
# (string) Writes the process id to this file on startup
#IROFFER_PIDFILE=mybot.pid

# ---- IRC / plaintext ----
# (func [yes|no] [also per-network]) Disable colors when announcing on this network.
#IROFFER_PLAINTEXT=

# ---- IRC / privmsg encrypt ----
# (bool [yes|no]) If set, all notice and privmsg will be encrypted.
#IROFFER_PRIVMSG_ENCRYPT=yes

# ---- IRC / privmsg fish ----
# (string) If set, decode encrypted messages with this global fish key.
#IROFFER_PRIVMSG_FISH=secret

# ---- IRC / custom connection info ----
# (func [multi: ';;'-separated] [also per-network]) if you use connectionmethod of custom you can place any number of custom lines for use with your proxy/gateway/redirector. Place "$s" and "$p" wher...
#IROFFER_PROXYINFO=connect $s:$p

# ---- Other / punish slow users ----
# (int) If a user is disconnected due to failing to meet a minspeed requirement, punish them by disconnecting all transfers/queues and ignoring them for n ...
#IROFFER_PUNISHSLOWUSERS=10

# ---- IRC / Queue Information ----
# (int) Main Queue Size, set to 0 for no queue
#IROFFER_QUEUESIZE=10

# ---- Other / quiet mode ----
# (bool [yes|no]) If defined, iroffer will suppress most informational messages to users No transfer completed message No DCC send remind message No XDCC QUEUE notif...
#IROFFER_QUIETMODE=yes

# ---- Other / quit message ----
# (string) Custom quit message to display or "none" if no message is desired. Default: Display iroffer version and optionally OS information.
#IROFFER_QUIT_MSG=Bye!

# ---- IRC / reconnect delay ----
# (int) Do not reconnect when connections is dropped for given seconds.
#IROFFER_RECONNECT_DELAY=15

# ---- IRC / reminder send retry ----
# (int) Defines how often the bot retries to start the XDDC SEND to the user. The default is 2 retries.
#IROFFER_REMINDER_SEND_RETRY=2

# ---- IRC / remove_dead_users ----
# (int) If the bot can't notify a nick: If set to 1, further queued messages are dropped. If set to 2, all this nicks queued packs are removed. Default: 0,...
#IROFFER_REMOVE_DEAD_USERS=2

# ---- IRC / remove lost files ----
# (bool [yes|no]) if a files is no longer accessible on the server, remove the pack. use with care, if started in wrong dir it may delete all packs.
#IROFFER_REMOVELOSTFILES=yes

# ---- IRC / requeue_sends ----
# (bool [yes|no]) When the bot shutdowns, sends are aborted. With this option set, sends are saved with the queued items, so transfers might resume on restart.
#IROFFER_REQUEUE_SENDS=yes

# ---- IRC / channel !list command ----
# (bool [yes|no] [also per-network]) if set, iroffer will respond to !list requests sent to a channel This setting can be global or per network.
#IROFFER_RESPONDTOCHANNELLIST=yes

# ---- IRC / channel !list text ----
# (string) text that is put int each response to !list in a channel.
#IROFFER_RESPONDTOCHANNELLISTMSG=packlist at http://www.example.com/

# ---- IRC / channel xdcc commands ----
# (bool [yes|no] [also per-network]) if set, iroffer will respond to xdcc requests sent to a channel in addition to xdcc requests sent to iroffer directly. This setting can be global o...
#IROFFER_RESPONDTOCHANNELXDCC=yes

# ---- IRC / restrict xdcc list and xdcc send ----
# (bool [yes|no] [also per-network]) if set, xdcc list and/or xdcc send|info will be restricted to users who are on a known channel. If a user is not on one of the known channels they ...
#IROFFER_RESTRICTLIST=yes
# (bool [yes|no])
#IROFFER_RESTRICTPRIVLIST=yes
# (string)
#IROFFER_RESTRICTPRIVLISTMSG=Wait for public list in the channel.
# (bool [yes|no] [also per-network])
#IROFFER_RESTRICTSEND=yes

# ---- IRC / restrictprivlistfull ----
# (bool [yes|no]) If set, "xdcc list all" will be rejected.
#IROFFER_RESTRICTPRIVLISTFULL=yes

# ---- IRC / restrictprivlistmain ----
# (bool [yes|no]) If set, "xdcc list" without an option will be rejected. This allows to list a single group only.
#IROFFER_RESTRICTPRIVLISTMAIN=yes

# ---- IRC / restrictsend delay ----
# (int) Time in seconds to wait after connect till restrictsend is enforced.
#IROFFER_RESTRICTSEND_DELAY=300

# ---- IRC / restrictsend timeout ----
# (int) Timeout in seconds to cancel transfer after user left channel.
#IROFFER_RESTRICTSEND_TIMEOUT=300

# ---- IRC / restrictsend warning ----
# (bool [yes|no]) If set, it will try to warn the user when he/she leaves the channel.
#IROFFER_RESTRICTSEND_WARNING=yes

# ---- Other / ruby script ----
# (string) Run a ruby script on each line the bot gets from the irc server.
#IROFFER_RUBY_SCRIPT="ruby-helper.rb"

# ---- IRC / send batch ----
# (bool [yes|no]) Permit XDCC BATCH. The packs are Queued up in the bot is possible. Default: disabled
#IROFFER_SEND_BATCH=yes

# ---- FILES / send listfile ----
# (func) Packnumber of xdcclistfile added to the bot, enables XDCC SEND LIST. A value of -1 will send the xdcclistfile without creating a pack. Default: off
#IROFFER_SEND_LISTFILE=1

# ---- FILES / send state file ----
# (string) send statefile every hour via DCC to the specified nick
#IROFFER_SEND_STATEFILE=XDCC|statistik

# ---- FILES / send state file minute ----
# (int) send statefile every hour via when the minute matches
#IROFFER_SEND_STATEFILE_MINUTE=0

# ---- IRC / server information ----
# (func [multi: ';;'-separated] [also per-network]) List server/ports in the form "server irc.domain.com 6667". Port is optional (default 6667). Server password should be listed 3rd if needed (port m...
#IROFFER_SERVER=irc.efnet.net

# ---- IRC / server connect timeout ----
# (func [also per-network]) Set the starting timeout in seconds on connect to the IRC-server. This setting can only be set per network. Default: 5
#IROFFER_SERVER_CONNECT_TIMEOUT=10

# ---- IRC / server send max ----
# (func [also per-network]) Restrict the size of the buffer the bot sends to the irc-server. Otherwise the bot will be banned cause of excess flooding. This setting is only pe...
#IROFFER_SERVER_SEND_MAX=600

# ---- IRC / server send rate ----
# (func [also per-network]) Limit the median number of characters per second the bot sends to the IRC server. Otherwise the bot will be banned cause of excess flooding. This s...
#IROFFER_SERVER_SEND_RATE=25

# ---- Other / show date added ----
# (bool [yes|no]) Show date the pack was added with XDCC LIST.
#IROFFER_SHOW_DATE_ADDED=yes

# ---- Other / show group of pack ----
# (bool [yes|no]) Export your xdcc list with group for each pack. Default output is just the packs
#IROFFER_SHOW_GROUP_OF_PACK=yes

# ---- Other / show list all ----
# (bool [yes|no]) Print line with "/msg nick xdcc list all".
#IROFFER_SHOW_LIST_ALL=yes

# ---- IRC / maximum xdcc slots ----
# (func)
#IROFFER_SLOTSMAX=20

# ---- IRC / slow slow_privmsg ----
# (func [also per-network]) Restrict PRIVMSG to n lines per sec in this network to avoid flooding. This setting is only per network. Default: 1
#IROFFER_SLOW_PRIVMSG=1

# ---- IRC / bypass queue for small files ----
# (int) If someone requests a small file, bypass queue and max sends. If the offered file is under this size (in KB), send immediately.
#IROFFER_SMALLFILEBYPASS=0

# ---- IRC / spaces in filenames ----
# (bool [yes|no]) Allow spaces in filenames via DCC Default: spaces are converted to '_'
#IROFFER_SPACES_IN_FILENAMES=yes

# ---- Network Usage / start of month ----
# (int) day of month when to reset the monthly traffic limit, default 1 this value is only checked when the old month is over.
#IROFFER_START_OF_MONTH=1

# ---- FILES / state file ----
# (func) temporary storage for iroffer state information across restarts
#IROFFER_STATEFILE=mybot.state

# ---- Network Usage / status time dcc chat ----
# (int) Defines the time in seconds for a status line in dcc chat. Default: 120
#IROFFER_STATUS_TIME_DCC_CHAT=120

# ---- IRC / subdirs delayed ----
# (bool [yes|no]) When configured, addir, addnew, and autoadd will scan subdirs later. This keeps the bot responsive if you have a huge directory tree. Default: off,...
#IROFFER_SUBDIRS_DELAYED=yes

# ---- IRC / TCP buffer size ----
# (int) Set the Networkbuffer for TCP connection to the given value in kByte. Default: 0 = the operating system default. On CYGWIN the default is 372
#IROFFER_TCP_BUFFER_SIZE=372

# ---- IRC / TCP no delay ----
# (bool [yes|no]) Disable the Nagle buffering algorithm in TCP. The operating system will not optimze the size of each TCP packet. Default: no, on CYGWIN Default: yes
#IROFFER_TCP_NODELAY=no

# ---- IRC / incoming TCP connections ----
# (int)
#IROFFER_TCPRANGELIMIT=65535
# (int) If you are behind a firewall that you control and want to have iroffer use a specified range for TCP ports for incoming connections set tcprangesta...
#IROFFER_TCPRANGESTART=4000

# ---- FILES / telnet allow ----
# (list [multi: ';;'-separated]) Defines ip networks, which are allowed to access the bot via telent. Multiple ip networks can be specified Default: all.
#IROFFER_TELNET_ALLOW=127.0.0.1

# ---- FILES / telnet deny ----
# (list [multi: ';;'-separated]) Defines ip networks, that should not access the bot via telnet. Multiple ip networks can be specified Default: none.
#IROFFER_TELNET_DENY=172.16.0.0/16

# ---- FILES / telnet port ----
# (int) Port for the build-in Telnet server. To login you must add adminhost or hadminhost with "telnet!*@telnet" Default: 0 = disabled.
#IROFFER_TELNET_PORT=2323

# ---- FILES / telnet vhost ----
# (list [multi: ';;'-separated]) List of up to 2 local IP addresses for the Telnet server to run on. Use "::" or "0.0.0.0" to allow any IP address. Use "::1" or "127.0.0.1" to limi...
#IROFFER_TELNET_VHOST=::1

# ---- Other / timestamp console ----
# (bool [yes|no]) If defined, iroffer will place timestamps on all console output
#IROFFER_TIMESTAMPCONSOLE=yes

# ---- Network Usage / daily/weekly/monthly limits ----
# (func) If you want to limit total sent during a day/week/month, define transferlimits and set one or more of the limits. Setting to 0 disables that limit,...
#IROFFER_TRANSFERLIMITS=200 1200 5000

# ---- Network Usage / transfer max speed ----
# (func) Per-transfer max speed in KB/sec used unless 'chmaxs' set per pack.
#IROFFER_TRANSFERMAXSPEED=50

# ---- Network Usage / transfer min speed ----
# (func) Per-transfer min speed in KB/sec used unless 'chmins' set per pack.
#IROFFER_TRANSFERMINSPEED=10

# ---- Other / trashcan dir ----
# (string) Instead of deleting files, they are moved to this directory. Default: delete files on disk.
#IROFFER_TRASHCAN_DIR=/home/me/trashcan

# ---- IRC / unlimited download hosts ----
# (list [multi: ';;'-separated]) Specify Nicks and Hostnames which are not limited in bandwidth.
#IROFFER_UNLIMITEDHOST=XDCC|*!*@*

# ---- Other / upload directory ----
# (string)
#IROFFER_UPLOADDIR=/home/me/upload
# (list [multi: ';;'-separated]) If you want iroffer to accept DCC transfers (upload) define one or more uploadhosts and define an uploaddir where files should be saved. uploadmaxs...
#IROFFER_UPLOADHOST=*!~me@*.domain.com
# (func)
#IROFFER_UPLOADMAXSIZE=10

# ---- Other / upload min space ----
# (func) Check free space on disk and do not start uploads when disk gets full. Specifies the minimum size in MB available before upload.
#IROFFER_UPLOADMINSPACE=10

# ---- IRC / UPnP router ----
# (bool [yes|no]) activate UPnP support. Requires iroffer be build with upnp support.
#IROFFER_UPNP_ROUTER=yes

# ---- IRC / manual dcc ip translation ----
# (string [also per-network]) if you are behind a NAT (Network Address Translation) device which _does_ _not_ intercept and translate dcc commands but _does_ do port forwarding ...
#IROFFER_USENATIP=192.0.2.200

# ---- IRC / user mode ----
# (string [also per-network]) user_modes global setting is required, can be changed per network B Marks you as being a Bot i Invisible (not shown in /who) Modes are diffrent on ...
#IROFFER_USER_MODES=+iB

# ---- IRC / user information ----
# (string)
#IROFFER_USER_REALNAME=Owner: OwnerNick mailto:user@example.com

# ---- Other / verbose crc32 ----
# (bool [yes|no]) By default, after adding iroffer will only report bad checksums. If set, it will print out the computed checksum in every case.
#IROFFER_VERBOSE_CRC32=yes

# ---- IRC / wait after join ----
# (int) When joining a channel, skip announces for given seconds. This will avoid banning your bot for join+spam. Default: 200 seconds.
#IROFFER_WAITAFTERJOIN=200

# ---- FILES / weblist info ----
# (list [multi: ';;'-separated]) Show additional information in the HTML page.
#IROFFER_WEBLIST_INFO=uptime "Uptime"

# ---- IRC / xdcc allow ----
# (list [multi: ';;'-separated]) Defines ip masks, which are allowed to download from the server. Multiple ip masks can be specified Default: all.
#IROFFER_XDCC_ALLOW=127.0.0.1

# ---- IRC / xdcc deny ----
# (list [multi: ';;'-separated]) Defines ip masks, that should not download from the server. Multiple ip masks can be specified Default: none.
#IROFFER_XDCC_DENY=172.16.0.0/16

# ---- FILES / xdcc list by privmsg ----
# (bool [yes|no]) send the result of XDCC LIST by privmsg instead of notice. Default: notice
#IROFFER_XDCCLIST_BY_PRIVMSG=yes

# ---- FILES / xdcc listing group only ----
# (bool [yes|no]) Export your xdcc list with group and main information only. Default output is all packs and no group information.
#IROFFER_XDCCLIST_GROUPONLY=yes

# ---- FILES / xdcc listing file ----
# (string) if you want to export your xdcc list via a webserver, or other means define 'xdcclistfile' and iroffer will write the xdcc list to it when needed. ...
#IROFFER_XDCCLISTFILE=mybot.txt
# (bool [yes|no])
#IROFFER_XDCCLISTFILERAW=yes

# ---- FILES / xdcc remove file ----
# (string) export stats on removed packs for better statistics.
#IROFFER_XDCCREMOVEFILE=mybot.removed.xdcc

# ---- FILES / xdcc xml file ----
# (string) if you want to export your packlist in XML define xdccxmlfile.
#IROFFER_XDCCXMLFILE=mybot.xml
