# Traefik stack environment
# Copy to .env and fill in. Never commit the real .env.

# --- Cloudflare (DNS-01 ACME challenges) ---
# Scoped API token: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone -> DNS -> Edit, for the zone(s) you issue certs for.
CF_DNS_API_TOKEN=""
# Optional: second token (Zone -> Zone -> Read) only for split-token setups
CF_ZONE_API_TOKEN=""

# --- ACME / certificate resolver ---
# Email for the Let's Encrypt account + expiry notices.
# NOTE: DNS-01 issues REAL public certificates, and Let's Encrypt will NOT
# issue certs for .lan / internal-only names. DASHBOARD_HOST and WHOAMI_HOST
# must be records inside a Cloudflare-managed zone (they can point at LAN IPs
# via DNS-only records; the proxy/orange-cloud setting does not matter).
ACME_EMAIL=you@example.com
# Host dir mounted at /acme where letsencrypt.json is written
# Host dir for letsencrypt.json (mounted at /acme)
ACME_DIR=./certs
# Host dir for Traefik dynamic config files (mounted at /dynamic, read-only)
DYNAMIC_DIR=./dynamic
# Host dir mounted read-only at /certs (optional extra cert bundle)
CERTS_DIR=./certs
# Resolver name (matches --certificatesresolvers.<name> in compose)
CERT_RESOLVER=letsencrypt

# --- Routing ---
# Dashboard hostname (Host rule for the api@internal router)
DASHBOARD_HOST=traefik.your-domain.tld
# Whoami test app hostname
WHOAMI_HOST=whoami.your-domain.tld

# Shared network name (external; create once: docker network create proxy)
TRAEFIK_NETWORK=proxy

# --- Authelia ---
# The dashboard and whoami routers reference the shared forwardAuth
# middleware authelia@docker defined in the authelia stack. No credentials
# live here — access rules belong in the Authelia configuration, e.g.:
#   access_control:
#     rules:
#       - domain: [traefik.your-domain.tld, whoami.your-domain.tld]
#         policy: one_factor
# Authelia must be up BEFORE this stack's routers, otherwise Traefik logs
# "middleware authelia@docker not found" and the routers stay unreachable.
