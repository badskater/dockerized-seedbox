# ============================================================
# rtorrent-rutorrent + Traefik — environment
# Copy to .env and adjust. All values below are working defaults.
# Every line here is passed to the container(s) via env_file.
# ============================================================

# --- Traefik ---
# External network your Traefik stack is attached to
TRAEFIK_NETWORK=proxy
# Entrypoint name for HTTPS (match your Traefik static config, often "websecure" or "https")
TRAEFIK_ENTRYPOINT=websecure
# Cert resolver name from your Traefik static config
CERT_RESOLVER=letsencrypt
# Traefik router/service names — must be unique across your whole stack
# (change if you run multiple instances); they are internal IDs, not URLs
ROUTER_NAME=rutorrent-user1
WEBDAV_ROUTER_NAME=rutorrent-user1-webdav
XMLRPC_ROUTER_NAME=rutorrent-user1-rpc
# Hostnames — REQUIRED (compose fails fast if unset)
RUTORRENT_HOST=rutorrent-user1.example.com
WEBDAV_HOST=webdav-user1.example.com
XMLRPC_HOST=rpc-user1.example.com

# --- Host paths (must be owned by PUID:PGID) ---
DATA_DIR=./data
DOWNLOADS_DIR=./downloads
PASSWD_DIR=./passwd
GEOIP_DATA_DIR=./data/geoip

# --- Service ports ---
# Keep these in sync: compose uses them for ports/expose/labels,
# the image uses them to bind its internal nginx servers.
# WARNING: port p+1 of each is reserved internally for health checks.
XMLRPC_PORT=8000
RUTORRENT_PORT=8080
WEBDAV_PORT=9000
# BitTorrent ports — published on the host, forward on your router/firewall
RT_INC_PORT=50000
RT_DHT_PORT=6881

# --- General ---
TZ=UTC
PUID=1000
PGID=1000
# Public IP reported to trackers; leave empty for auto-detect.
# Useful behind a VPN that reports a wrong IP.
WAN_IP=
# Or resolve it dynamically, e.g.: curl -s ifconfig.me
WAN_IP_CMD=
MEMORY_LIMIT=256M
NGINX_WORKER_PROCESSES=auto
UPLOAD_MAX_SIZE=16M
CLEAR_ENV=yes
OPCACHE_MEM_SIZE=128
MAX_FILE_UPLOADS=50
AUTH_DELAY=0s
# Set REAL_IP_FROM to your Traefik network CIDR (e.g. 172.20.0.0/16) so nginx
# logs show real client IPs instead of the proxy IP.
REAL_IP_FROM=0.0.0.0/32
REAL_IP_HEADER=X-Forwarded-For
LOG_IP_VAR=remote_addr
LOG_ACCESS=true

# --- Basic auth banners ---
XMLRPC_AUTHBASIC_STRING=rTorrent XMLRPC restricted access
XMLRPC_SIZE_LIMIT=1M
RUTORRENT_AUTHBASIC_STRING=ruTorrent restricted access
WEBDAV_AUTHBASIC_STRING=WebDAV restricted access

# --- rTorrent tuning ---
RT_LOG_LEVEL=info
RT_LOG_EXECUTE=false
RT_LOG_XMLRPC=false
# Seconds between session saves (default 3600; higher = less disk wear)
RT_SESSION_SAVE_SECONDS=3600
RT_SESSION_FDATASYNC=false
# Delay tracker announces at startup — keeps rTorrent stable with many torrents
RT_TRACKER_DELAY_SCRAPE=true
# TCP buffers: 4M is right for 4-16GB RAM; see image README for other tiers
RT_SEND_BUFFER_SIZE=4M
RT_RECEIVE_BUFFER_SIZE=4M
# Disk preallocation: 0=off, 1=on file open (saves space), 2=whole torrent (HDD speed)
RT_PREALLOCATE_TYPE=0

# --- ruTorrent ---
# Comma-separated core plugins to remove, or false to keep all
RU_REMOVE_CORE_PLUGINS=
RU_HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36
RU_HTTP_TIME_OUT=30
RU_HTTP_USE_GZIP=true
RU_HTTP_VERIFY_CERTIFICATES=true
RU_RPC_TIME_OUT=5
RU_LOG_RPC_CALLS=false
RU_LOG_RPC_FAULTS=true
RU_PHP_USE_GZIP=false
RU_PHP_GZIP_LEVEL=2
RU_SCHEDULE_RAND=10
RU_LOG_FILE=/data/rutorrent/rutorrent.log
RU_DO_DIAGNOSTIC=true
RU_CACHED_PLUGIN_LOADING=false
RU_PLUGIN_MINIFICATION=true
RU_SAVE_UPLOADED_TORRENTS=true
RU_OVERWRITE_UPLOADED_TORRENTS=false
RU_FORBID_USER_SETTINGS=false
RU_LOCALE=UTF8

# --- geoip-updater (only used by the "geoip" profile service) ---
GEOIPUPDATE_EDITION_IDS=GeoLite2-City GeoLite2-ASN
GEOIPUPDATE_FREQUENCY=24
# Free MaxMind account credentials
GEOIPUPDATE_ACCOUNT_ID=
GEOIPU…EY=
