# Dockhand stack configuration — copy to .env and fill in.

# --- Traefik routing ---
# Public hostname for the Dockhand UI (must be a DNS name your cert resolver can issue for)
DOCKHAND_HOST=dockhand.example.com
# Internal container port (Dockhand listens on 3000; only change if the image changes)
DOCKHAND_PORT=3000
# Router name, entrypoint, cert resolver, shared network — house defaults
ROUTER_NAME=dockhand
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=proxy

# --- Database ---
POSTGRES_USER=dockhand
POSTGRES_DB=dockhand
# CHANGE THIS — the compose file builds DATABASE_URL from these values.
# Avoid characters that need URL-encoding (@ : / # ?) or quote the whole URL instead.
POSTGRES_PASSWORD=changeme

# --- Paths ---
# Host directory bind-mounted to /app/data in the container
# Host directory for Dockhand app data (default: ./data next to compose)
DATA_DIR=./data
