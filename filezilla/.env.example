# ---- Traefik integration ----
# External Docker network shared with Traefik (create once: docker network create proxy)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt

# Hostname for the FileZilla web GUI
# REQUIRED — compose fails fast if unset.
FILEZILLA_HOST=filezilla.example.com

# Internal router/service name — must be unique across your whole stack
ROUTER_NAME=filezilla

# ---- Image / runtime ----
# Image tag (linuxserver publishes dated versions + latest)
IMAGE_TAG=latest
# Selkies needs shared memory for the video stream; 1gb is the recommended minimum
SHM_SIZE=1gb

# Container user owning the mounted dirs (from `id` on the host)
PUID=1000
PGID=1000
TZ=Etc/UTC

# ---- Host directories (must be writable by PUID:PGID) ----
# FileZilla config: settings, site manager, session state
CONFIG_DIR=./config
# Files to browse/transfer inside the GUI
DATA_DIR=./data

# ---- Internal port (must match compose.yaml; default shown) ----
# 3000 = HTTP (proxied by Traefik); 3001 = container's own HTTPS (unused here)
FILEZILLA_PORT=3000

# ---- Optional: image-level HTTP basic auth ----
# Setting BOTH enables basic auth inside the container. Suitable only for a
# trusted LAN — for real protection use the authelia@docker middleware
# (see the SECURITY note in compose.yaml). Leave unset to disable.
# CUSTOM_USER=filezilla
# PASSWORD=change-me
#
# Session locale, e.g. ja_JP.UTF-8, de_DE.UTF-8 (see linuxserver docs)
# LC_ALL=en_US.UTF-8
