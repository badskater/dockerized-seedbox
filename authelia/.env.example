# Authelia — secrets and compose-level settings
# Generate each secret with:  openssl rand -base64 32
AUTHELIA_SESSION_SECRET=change…and64
AUTHELIA_STORAGE_ENCRYPTION_KEY=change…and64
# Only needed if you enable the OIDC provider in configuration.yml
AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET=change…and64

# Container user owning the mounted config dir (from `id` on the host)
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Compose-level settings ---
# NOTE: these must NOT be named AUTHELIA_* — Authelia treats every AUTHELIA_*
# env var as a config key override (AUTHELIA_HOST/AUTHELIA_PORT hit deprecated
# 'host'/'port' keys and break the server.address mapping).
# Host rule for the Authelia portal (keep in sync with domains in configuration.yml)
PORTAL_HOST=id.example.com
PORTAL_PORT=9091
CONFIG_DIR=./config
ROUTER_NAME=authelia
MIDDLEWARE_NAME=authelia
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=proxy
