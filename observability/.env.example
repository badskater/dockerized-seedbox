# Observability stack environment
# Copy to .env and fill in. Never commit the real .env.

# --- Routing (Traefik) ---
# Hostnames must be DNS records inside your Cloudflare-managed zone
# (DNS-only records pointing at LAN IPs are fine).
PROM_HOST=prometheus.your-domain.tld
GRAFANA_HOST=grafana.your-domain.tld

# Router names (must be unique cluster-wide when running multiple instances)
PROM_ROUTER=prometheus
GRAFANA_ROUTER=grafana

# Traefik integration
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=proxy

# --- Ports (internal, expose-only — never published on the host) ---
PROM_PORT=9090
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8081

# --- Storage / retention ---
DATA_DIR=./data
CONFIG_DIR=./config
PROM_RETENTION=15d
CADVISOR_INTERVAL=15s

# --- Grafana (GF_* go straight to the Grafana container via env_file) ---
# Admin password — set a strong one. Grafana prompts a change on first login
# unless GF_SECURITY_ADMIN_PASSWORD__FILE or skip-change is used.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=""
# Must match GRAFANA_PORT above (Grafana binds this inside the container).
GF_SERVER_HTTP_PORT=3000
# Behind Traefik: let Grafana trust the proxy headers.
GF_SERVER_ROOT_URL=https://grafana.your-domain.tld
GF_USERS_ALLOW_SIGN_UP=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false

# --- Authelia ---
# The prometheus and grafana routers use the shared forwardAuth middleware
# authelia@docker (defined in the authelia stack). Add matching access
# rules in Authelia's configuration, e.g.:
#   access_control:
#     rules:
#       - domain: [prometheus.your-domain.tld, grafana.your-domain.tld]
#         policy: one_factor
# Authelia must be up BEFORE this stack, otherwise Traefik logs
# "middleware authelia@docker not found" and the routers stay unreachable.
